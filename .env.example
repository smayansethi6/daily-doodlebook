# Copy to .env and fill in.

# Browser-visible: VITE_ variables are compiled into the JavaScript every
# visitor downloads. The Supabase anon key is designed to be public.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only: read by the functions in /api, never sent to the browser.
# Never give these a VITE_ prefix.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
